# Shared password (required for local access)
DEMO_PASSWORD=verdia-demo

# Required: BFF persists to Supabase (Postgres + Storage)
# Apply supabase/migrations/*.sql in timestamp order
SUPABASE_URL=
# Secret key from Dashboard → API Keys (sb_secret_…)
SUPABASE_SECRET_KEY=

# Live grass classifier (Google AI Studio). Set this on Vercel for Nova captura.
# Same key as services/ai/.env. Optional VLM_MODEL (default gemma-4-26b-a4b-it).
# GOOGLE_API_KEY=

# Optional local Python Inference HTTP. Ignored when GOOGLE_API_KEY is set.
# Example: http://127.0.0.1:8000
# VLM_INFERENCE_URL=
